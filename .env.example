# GitCity v0.9.15 example environment
APP_BASE_URL=http://127.0.0.1:8004
APP_ENV=development
# REPOWORLD_DB_PATH=./.data/repoworld.sqlite3

# Anonymous browser workspaces are automatic. No OAuth credentials needed.
# Workspaces are stored per browser cookie, not user accounts.

# Public GitHub API read requests; optional for higher rate budgets
GITHUB_TOKEN=

# Optional live AI developer explanations and tours
# Shared provider capacity can queue requests. This read timeout is 180 seconds by default; 30-240 supported.
BHARATCODE_TIMEOUT_SECONDS=180
BHARATCODE_API_KEY=

# Public demo limits (enforced on Vercel or when APP_ENV=production).
REPOWORLD_AI_GLOBAL_DAILY=15
REPOWORLD_AI_GUEST_DAILY=3
REPOWORLD_AI_GUEST_10MIN=2
REPOWORLD_IMPORT_GLOBAL_HOURLY=300
REPOWORLD_IMPORT_GUEST_HOURLY=100
REPOWORLD_IMPORT_GLOBAL_5MIN=30
REPOWORLD_IMPORT_GUEST_5MIN=15
# Do not enable IP budgets behind a shared reverse proxy without trusted IP forwarding.
REPOWORLD_ENABLE_IP_BUDGET=0

# Optional GitHub sample-size override. Default: 6 without GITHUB_TOKEN, 16 with it.
# REPOWORLD_IMPORT_SOURCE_LIMIT=6

# Production only: require a real volume mount before reporting readiness.
# REPOWORLD_REQUIRE_MOUNTED_DB=1
# Render provides RENDER_EXTERNAL_URL; APP_BASE_URL overrides it for a custom domain.

# Vercel: use a dedicated libSQL database and set both variables privately.
# GITCITY_TURSO_DATABASE_URL=libsql://your-database.turso.io
# GITCITY_TURSO_AUTH_TOKEN=

# Optional: dedicated GitCity public-snapshot PostgreSQL database ONLY.
# Never use another app's existing DB. Requires scripts/gitcity_public_cache.sql.
# Stores only bounded public repository graph metadata (NO guest sessions).
# On Render Free leave unset until the separately approved Neon database exists.
# GITCITY_PUBLIC_CACHE_DATABASE_URL=postgresql://gitcity_user:***@hostname/gitcity?sslmode=require

# Platforms provide a deployment SHA through VERCEL_GIT_COMMIT_SHA or RENDER_GIT_COMMIT.
# Optional local-only test: GITCITY_BUILD_SHA=<40-hex-digit-public-commit>
